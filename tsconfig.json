{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "incremental": true,
    "module": "esnext",
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",  // 👈 এটা যোগ করুন
    "paths": {      // 👈 পাথ অ্যালিয়াস এখানে যোগ করুন
      "@/*": ["./src/*"],
      "@/app/*": ["./src/app/*"],
      "@/components/*": ["./src/components/*"],
      "@/lib/*": ["./src/lib/*"]
      // "@/features/*": ["./src/features/*"],
      // "@/hooks/*": ["./src/hooks/*"],
      // "@/utils/*": ["./src/utils/*"],
      // "@/types/*": ["./src/types/*"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    "**/*.ts",
    "**/*.tsx",
    "src/**/*"  // 👈 src ফোল্ডার ইনক্লুড করুন
  ],
  "exclude": [
    "node_modules"
  ]
}